      "pre_patch_sha256": "sha256:7ff0071fb95c21144e5ef13946c87bb8830ae3902e4d2f25a2c5342a1df522ee",
      "replace": {
        "name": "Connection Request",
        "type": "bytearray",
        "constraints": {
