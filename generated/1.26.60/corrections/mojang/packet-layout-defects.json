    {
      "id": "player-video-capture-has-one-action-union",
      "file": "PlayerVideoCapturePacketPayload.json",
      "pointer": "/properties",
      "pre_patch_sha256": "sha256:bec1a56f7f8fd8f03d01a077061437916a31634a57f7865fa17bb6e095adf4c3",
      "replace": {
        "Action": {
          "oneOf": [
            {
              "$ref": "./Stop_Video_Capture.json"
            },
            {
              "$ref": "./Start_Video_Capture.json"
            }
          ],
          "x-control-value-type": "uint8",
          "x-ordinal-index": 0
        }
      },
      "why": "The v2225 codec inherits a one-byte action selector: STOP_VIDEO_CAPTURE is 0 and START_VIDEO_CAPTURE is 1, followed by frame rate and file prefix. The same values and framing are used by gophertunnel at 8c30047d86617a56e1f1871e3a1d47ec4f670d99.",
      "evidence": [
        {
          "locator": "https://github.com/CloudburstMC/Protocol/blob/17a89ac156ff874fc8773e42a96bbc0635be9eed/bedrock-codec/src/main/java/org/cloudburstmc/protocol/bedrock/codec/v786/serializer/PlayerVideoCaptureSerializer_v786.java",
          "summary": "The v2225 codec inherits a one-byte action selector: STOP_VIDEO_CAPTURE is 0 and START_VIDEO_CAPTURE is 1, followed by frame rate and file prefix. The same values and framing are used by gophertunnel at 8c30047d86617a56e1f1871e3a1d47ec4f670d99."
        }
      ]
    }
  ]
